{
  "name": "node-polycall",
  "version": "1.1.0",
  "package": "@obinexuscomputing/node-polycall",
  "language": "JavaScript (Node.js)",
  "adapter": false,
  "ffi": "optional: node:ffi (Node.js >= 26 with --experimental-ffi)",
  "ffi_symbols": ["polycall_ffi_abi_version", "polycall_ffi_version", "polycall_strerror", "polycall_last_error",
                  "polycall_ffi_run_config", "polycall_ffi_describe", "polycall_call"],
  "library": ["$POLYCALL_LIBRARY", "polycall.dll", "libpolycall.dll", "libpolycall.so.1", "libpolycall.1.dylib"],
  "transport": ["polycall_rpc v1 (PCR1)", "polycall-peer/1"],
  "core": "polycall >= 1.1.0 (binding ABI 1)",
  "core_repository": "https://github.com/obinexus/polycall",
  "license": "MIT",
  "author": "OBINexusComputing"
}
